{
  "name": "pixpage-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=iife --target=es2022 --jsx=automatic --loader:.woff2=file --asset-names=fonts/[name]-[hash] --outdir=dist --entry-names=app --legal-comments=none --define:process.env.NODE_ENV='\"production\"'",
    "watch": "npm run build -- --watch"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "dompurify": "3.4.16",
    "marked": "18.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
